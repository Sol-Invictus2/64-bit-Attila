<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- 64-bit Attila: the Linux game file works with UTF-8 file names, so the "A" functions of Windows get UTF-8 too (Windows 10 1903 and
     later). Without this, a game, Steam library or user folder whose name has letters such as é, å or Russian ones breaks mod loading. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
